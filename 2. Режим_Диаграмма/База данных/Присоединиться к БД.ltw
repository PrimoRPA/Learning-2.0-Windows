                    <Value xsi:type="xsd:boolean">false</Value>
                </SerializationItem>
                <SerializationItem>
                    <IsListValue>false</IsListValue>
                    <Name>IsCollapsed</Name>
                    <Value xsi:type="xsd:boolean">false</Value>
                </SerializationItem>
                <SerializationItem>
                    <IsListValue>false</IsListValue>
                    <Name>ShowAnnotation</Name>
                    <Value xsi:type="xsd:boolean">true</Value>
                </SerializationItem>
            </Properties>
            <IsBreakpoint>false</IsBreakpoint>
            <IsIgnore>false</IsIgnore>
            <Components>
                <SerializationComponent xsi:type="SerializationContainer">
                    <ClassName>LTools.Database.Elements.WFConnectDatabase</ClassName>
                    <AssemblyName>LTools.Database, Version=1.0.1.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                    <Properties>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>ConnectionString</Name>
                            <Value xsi:type="xsd:string">"Driver={Microsoft Excel Driver (*.xls, *.xlsx, *.xlsm, *.xlsb)};Dbq="+ excelPath</Value>
                        </SerializationItem>
                        <SerializationItem>
