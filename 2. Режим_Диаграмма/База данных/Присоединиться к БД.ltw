                    <Name>PreventLogging</Name>
                    <Value xsi:type="xsd:boolean">false</Value>
                </SerializationItem>
                <SerializationItem>
                    <IsListValue>false</IsListValue>
                    <Name>SSSuccess</Name>
                    <Value xsi:type="xsd:boolean">false</Value>
                </SerializationItem>
                <SerializationItem>
                    <IsListValue>false</IsListValue>
                    <Name>SSFail</Name>
                    <Value xsi:type="xsd:boolean">false</Value>
                </SerializationItem>
                <SerializationItem>
                    <IsListValue>true</IsListValue>
