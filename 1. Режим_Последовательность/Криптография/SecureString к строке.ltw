                    <SerializationItem>
                        <IsListValue>false</IsListValue>
                        <Name>Data</Name>
                        <Value xsi:type="xsd:string">strPass.ToCharArray().Aggregate( new System.Security.SecureString(), (s, c) =&gt; { s.AppendChar(c); return s; }, (s)    =&gt; { s.MakeReadOnly(); return s; });</Value>
