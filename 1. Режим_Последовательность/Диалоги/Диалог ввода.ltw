                <Properties>
                    <SerializationItem>
                        <IsListValue>false</IsListValue>
                        <Name>MsgTitle</Name>
                        <Value xsi:type="xsd:string">"Primo Learning"</Value>
                    </SerializationItem>
                    <SerializationItem>
                        <IsListValue>false</IsListValue>
                        <Name>Text</Name>
                        <Value xsi:type="xsd:string">"Понятно ли изложена информация в файлах Learning?"</Value>
                    </SerializationItem>
                    <SerializationItem>
                        <IsListValue>false</IsListValue>
