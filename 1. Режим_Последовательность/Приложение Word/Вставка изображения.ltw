                                <Value xsi:type="xsd:string">image</Value>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Bookmark</Name>
                                <Value xsi:type="xsd:string">"BookmarkPrimo"</Value>
                            </SerializationItem>
