            <SerializationComponent>
                <ClassName>LTools.Workflow.Elements.WFMultipleAssign</ClassName>
                <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                <Properties>
                    <SerializationItem>
                        <IsListValue>false</IsListValue>
                        <Name>ComponentName</Name>
                        <Value xsi:type="xsd:string">Множественное присвоение</Value>
                    </SerializationItem>
                    <SerializationItem>
                        <IsListValue>false</IsListValue>
                        <Name>Annotation</Name>
                        <Value xsi:type="xsd:string">Переменные:
1) Булевое значение 
2) Строковое значение 
3) Числовое значение 

В данном контейнере можно производить присвоение любого типа для нескольких переменных

*Для перемещения переменных нужно использовать стрелки слева от окна ввода названия переменной
*Для расширения окна ввода нужно нажать на многоточие возле окон ввода названия и значения переменных
*Для удаления одного из присвоений нужно нажать на крестик справа</Value>
                    </SerializationItem>
                    <SerializationItem>
                        <IsListValue>true</IsListValue>
                        <Name>Items</Name>
                        <ListValue>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Items</Name>
                                <Value xsi:type="MultipleAssignItem">
                                    <Variable>boolVariable</Variable>
                                    <IsNoCodeVariable>false</IsNoCodeVariable>
                                    <Assign>1 &lt; 2</Assign>
                                    <IsNoCodeAssign>false</IsNoCodeAssign>
                                </Value>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Items</Name>
                                <Value xsi:type="MultipleAssignItem">
                                    <Variable>strVariable</Variable>
                                    <IsNoCodeVariable>false</IsNoCodeVariable>
                                    <Assign>"3" + "4"</Assign>
                                    <IsNoCodeAssign>false</IsNoCodeAssign>
                                </Value>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Items</Name>
                                <Value xsi:type="MultipleAssignItem">
                                    <Variable>intVariable</Variable>
                                    <IsNoCodeVariable>false</IsNoCodeVariable>
                                    <Assign>5 + 6</Assign>
                                    <IsNoCodeAssign>false</IsNoCodeAssign>
                                </Value>
                            </SerializationItem>
                        </ListValue>
                    </SerializationItem>
