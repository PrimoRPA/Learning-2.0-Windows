            <DataTypeString>System.Data.DataRow</DataTypeString>
            <Direction>IN_OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>inference</Name>
            <Group />
            <DefaultValue xsi:type="xsd:string">new Primo.AI.Server.Model.InferenceResult()</DefaultValue>
            <Comment>Результат, получаемый от AI Server по ключу запроса</Comment>
            <DataTypeString>Primo.AI.Server.Model.InferenceResult</DataTypeString>
            <Direction>IN_OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>progress</Name>
            <Group />
            <Comment>Счетчик попыток получения результата от AI Server</Comment>
            <DataTypeString>Int32</DataTypeString>
            <Direction>IN_OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>handle</Name>
            <Group />
            <Comment>Уникальный идентификатор ресурса Windows используемый для управления им</Comment>
            <DataTypeString>System.Int32</DataTypeString>
            <Direction>IN_OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>handleProcess</Name>
            <Group />
            <Comment>Показывает индикатор прогресса и управлять его состоянием</Comment>
            <DataTypeString>System.Int32</DataTypeString>
            <Direction>IN_OUT</Direction>
        </ScriptVariable>
        <ScriptVariable>
            <Name>modelType</Name>
            <Group />
