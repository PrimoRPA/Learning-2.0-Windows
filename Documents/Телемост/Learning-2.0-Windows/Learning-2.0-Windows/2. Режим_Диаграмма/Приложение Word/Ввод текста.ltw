                                    <IsListValue>false</IsListValue>
                                    <Name>Text</Name>
                                    <Value xsi:type="xsd:string">"Сегодня можно с уверенностью сказать, что российский рынок RPA находится в стадии активного развития. "</Value>
                                </SerializationItem>
