                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
    	string str = "width: 5px; user-select: text; border: none;&gt;&lt;span&gt;В ответственность вашей команды поступила заявка &lt;a href=https://itsm.ru/sd/operator/?anchor=uuid:serviceCall$271504680style=text-decoration-line: none; color: #085896;&gt;321946&lt;/a&gt;.&lt;/span&gt;&amp;nbsp;&lt;/td&gt;";

		System.Text.RegularExpressions.MatchCollection ret = new System.Text.RegularExpressions.Regex(str, System.Text.RegularExpressions.RegexOptions.None).Matches(@"https://itsm.ru/sd/operator/\?anchor=uuid:serviceCall(.*?\d+)");
		
		LTools.Workflow.PrimoApp.MessageBox(wf, ret[0].ToString());
    }
}</Value>
