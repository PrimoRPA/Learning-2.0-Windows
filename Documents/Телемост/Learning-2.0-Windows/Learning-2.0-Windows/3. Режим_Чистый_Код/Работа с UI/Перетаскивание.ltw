                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
	  //Запуск приложения Paint
      System.Diagnostics.Process app = LTools.Desktop.DesktopApp.Start(wf, @"mspaint.exe","", "", LTools.Desktop.Model.DesktopTypes.UIAUTOMATION, true);
	  //Присоединиться к приложению Paint
	  LTools.Desktop.DesktopApp appAttached = LTools.Desktop.DesktopApp.Init(wf, "", "Безымянный - Paint", 10000, false, LTools.Desktop.Model.DesktopTypes.UIAUTOMATION);
	  //Разворачиваем окно	
      appAttached.Maximize(10000);
	  //Чтобы выбрать контрол, в который робот будет вписать текст, нажми на "волшебую палочку"
	  //После чего студия начнет подсвечивать все контролы на сайте/приложении.
	  //В данном примере мы использовали invoke click
	  //В нашем примере использовался Paint на русском языке. 
	  //Обратите внимание на это, когдда будете запускать пример.
	  appAttached.Click("{\"Name\":\"Сердце\",\"ControlType\":\"ControlType.ListItem\",\"AUIProperties\":[{\"Key\":\"Text\",\"Value\":\"Сердце\"}],\"TextSearchMode\":0,\"IsRoot\":false,\"IsQuickSearch\":true,\"IsApplet\":false,\"DesktopType\":0}",LTools.Desktop.Model.MouseButtons.BUTTON_LEFT, LTools.Desktop.Model.KeyboardKeys.NONE, 10000);
	   
      appAttached.DragNDrop("{\"Items\":[{\"Values\":[{\"Key\":\"Name\",\"Value\":\"Сердце\",\"ValueKind\":0},{\"Key\":\"ControlType\",\"Value\":\"ControlType.ListItem\",\"ValueKind\":0},{\"Key\":\"IsRoot\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\"IsQuickSearch\",\"Value\":\"True\",\"ValueKind\":0},{\"Key\":\"IsStrictSearch\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\"IsApplet\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\".DesktopType\",\"Value\":\"UIAUTOMATION\",\"ValueKind\":0},{\"Key\":\".TransientEditState\",\"Value\":\"{\\\"IsStrictSearch\\\":true}\",\"ValueKind\":0},{\"Key\":\"Text\",\"Value\":\"Сердце\",\"ValueKind\":0}],\"Items\":[]}],\"ContainerID\":\"c1ad53ad-6c7c-4794-bbdd-8aae05080822\",\"LastContainerName\":\"Присоединиться к приложению Paint\",\"LastContainerType\":0,\"AppType\":5}", 
		"{\"Items\":[{\"Values\":[{\"Key\":\"Name\",\"Value\":\"Использование инструмента Сердце на Холст\",\"ValueKind\":0},{\"Key\":\"ClassName\",\"Value\":\"Afx:00007FF7E1470000:8\",\"ValueKind\":0},{\"Key\":\"ControlType\",\"Value\":\"ControlType.Pane\",\"ValueKind\":0},{\"Key\":\"IsRoot\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\"IsQuickSearch\",\"Value\":\"True\",\"ValueKind\":0},{\"Key\":\"IsStrictSearch\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\"IsApplet\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\".DesktopType\",\"Value\":\"UIAUTOMATION\",\"ValueKind\":0},{\"Key\":\".TransientEditState\",\"Value\":\"{\\\"IsStrictSearch\\\":true}\",\"ValueKind\":0},{\"Key\":\"Text\",\"Value\":\"Использование инструмента Сердце на Холст\",\"ValueKind\":0}],\"Items\":[]}],\"ContainerID\":\"c1ad53ad-6c7c-4794-bbdd-8aae05080822\",\"LastContainerName\":\"Присоединиться к приложению Paint\",\"LastContainerType\":0,\"AppType\":5}", 10, 663, 10, 55, 10000);
	  
    }
}</Value>
