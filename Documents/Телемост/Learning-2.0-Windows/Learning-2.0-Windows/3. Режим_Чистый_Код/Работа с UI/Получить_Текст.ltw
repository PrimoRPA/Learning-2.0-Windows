                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
      //Компонент позволяет получить текст из выбранного элемента управления.
	  //Данный элемент может использовать,как и для браузерных приложений, так и десктопных.
	  //Чтобы посмотреть работу бразуера используйте if (true)
	  //Чтобы посмотреть работу бразуера используйте if (false)
     if (false){
	 //Открываем браузер, а странице "https://www.html-code-generator.com/demo/html/select-option-list"
     //Для работы данного компонента вам нужно установить расширение.
     //Чтобы это сделать воспользуйтесь гайдом:
     //https://docs.primo-rpa.ru/primo-rpa/primo-rpa-studio/settings/plugin-install/chrome

     //*Мы использовали Google Chrome, в настройках можно выбрать другой браузер, 
     //но в таком случае можно использовть установку другого расширения. 
     //Браузер IE установки расширения не требует
	 //Открыть браузер с URL:
     LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, LTools.WebBrowser.Model.BrowserTypes.Chrome, "https://www.html-code-generator.com/demo/html/select-option-list");
	//Прочитаем текст заголовка
     string text_example = app.GetInnerText("{\"Items\":[{\"Values\":[{\"Key\":\".Tag\",\"Value\":\"H1\",\"ValueKind\":0},{\"Key\":\".SearchFrames\",\"Value\":\"False\",\"ValueKind\":0}],\"Items\":[]}],\"ContainerID\":\"f1bf5cff-f846-413a-9401-3c522817a51f\",\"LastContainerName\":\"Открыть браузер сайт \",\"LastContainerType\":1,\"AppType\":5}", 10000);
      
	 }else
	 {
	   //Запускаем приложение MyCRM. Оно будет расположено в дополнительных материалах
       System.Diagnostics.Process app = LTools.Desktop.DesktopApp.Start(wf, System.IO.Path.Combine(Environment.CurrentDirectory, @"Дополнительные материалы\MyCRM.exe"),"", "", LTools.Desktop.Model.DesktopTypes.UIAUTOMATION, true);
		//Присоединение к окну приложения
        LTools.Desktop.DesktopApp appAttached = LTools.Desktop.DesktopApp.Init(wf, "", "My CRM (Sample App)", 10000, false, LTools.Desktop.Model.DesktopTypes.UIAUTOMATION);
       //прочитаем Имя
        string text_example = appAttached.GetInnerText("{\"Items\":[{\"Values\":[{\"Key\":\"Name\",\"Value\":\"First:\",\"ValueKind\":0},{\"Key\":\"AutomationID\",\"Value\":\"textBoxPeopleFirstName\",\"ValueKind\":0},{\"Key\":\"ClassName\",\"Value\":\"WindowsForms10.EDIT.app.0.378734a\",\"ValueKind\":0},{\"Key\":\"ControlType\",\"Value\":\"ControlType.Edit\",\"ValueKind\":0},{\"Key\":\"IsRoot\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\"IsQuickSearch\",\"Value\":\"True\",\"ValueKind\":0},{\"Key\":\"IsApplet\",\"Value\":\"False\",\"ValueKind\":0},{\"Key\":\".DesktopType\",\"Value\":\"UIAUTOMATION\",\"ValueKind\":0}],\"Items\":[]}],\"ContainerID\":\"c2b58050-d983-42d6-8d75-59bdf31e79a8\",\"LastContainerName\":\"Присоединиться к приложению MyCRM\",\"LastContainerType\":0,\"AppType\":5}", 10000);
        LTools.Workflow.PrimoApp.AddToLog(wf, text_example, LTools.Enums.LogMessageType.Info);
	 }
	
        
    }
}</Value>
