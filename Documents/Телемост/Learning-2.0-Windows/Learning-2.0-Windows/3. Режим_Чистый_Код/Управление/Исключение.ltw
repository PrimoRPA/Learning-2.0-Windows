                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		//Чтобы продемонстрировать работу элемента "Исключение" снаружи контейнера Try-Catch используйте if (true)
		//Чтобы продемонстрировать работу элемента "Исключение" внутри контейнера Try-Catch используйте if (false)
		if (true){
			//В случае, если исключение вызвано снаруже контейнера Try-Catch, оно будет отлавливаться контейнером 
			//Try-Catch оборачивающим ltw в котором исключение было вызвано (не попадет ни в один Try-Catch внутри ltw, 
			//в котором вызвано). Если такого блока нет, робот завершит работу указав текст ошибки в консоли
			throw new Exception("Исключение для демонстрации Try-Catch");
			try
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Try", LTools.Enums.LogMessageType.Info);
			}
			catch (Exception e) when (e is not OperationCanceledException)
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Catch. Возникла ошибка: " + e.Message, LTools.Enums.LogMessageType.Info);
			}
			finally
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Finally. Работа Try-Catch завершена", LTools.Enums.LogMessageType.Info);
			}
			LTools.Workflow.PrimoApp.AddToLog(wf, "Лог снаружи контейнера Try Catch", LTools.Enums.LogMessageType.Info);
		}else{
			try
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Try", LTools.Enums.LogMessageType.Info);
				//В случае, если исключени вызвано в контейнере Try-Catch, 
				//оно будет поймано в блоке Catch для последующей обработки
				throw new Exception("Исключение для демонстрации Try-Catch");
			}
			catch (Exception e) when (e is not OperationCanceledException)
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Catch. Возникла ошибка: " + e.Message, LTools.Enums.LogMessageType.Info);
			}
			finally
			{
				LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Finally. Работа Try-Catch завершена", LTools.Enums.LogMessageType.Info);
			}
			LTools.Workflow.PrimoApp.AddToLog(wf, "Лог снаружи контейнера Try Catch", LTools.Enums.LogMessageType.Info);
		}
    }
}</Value>
            </SerializationItem>
