using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, производящий запись данных в ячейку Excel.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		text - Текст: [String] Текст подсказки
		x - X: [Int32] Координата X
		y - Y: [Int32] Координата Y
		width - Ширина: [Int32] Ширина подсказки
		height - Высота: [Int32] Высота подсказки
		ctrl - Элемент (Рабочий стол): [LTools.Desktop.Model.DUIControl] Элемент рабочего стола
		ctrl - Элемент (Браузер): [LTools.WebBrowser.Model.IElementInfo] Элемент браузера
		
		LTools.Office.AssistantApp app = new LTools.Office.AssistantApp();
		app.Text = text;
		app.ShowHint(wf, x, y, width, height);
		app.ShowHint(wf, ctrl, width, height);
		*/
		
		LTools.Office.AssistantApp app = new LTools.Office.AssistantApp();
		app.Text = "Изучение элементов студии\nПодсказка по указанным координатам";
		app.ShowHint(wf, 200, 100, 300, 100);
    }
}</Value>
