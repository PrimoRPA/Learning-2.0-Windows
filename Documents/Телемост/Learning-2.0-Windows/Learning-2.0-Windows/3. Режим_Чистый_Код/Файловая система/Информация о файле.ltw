                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		var strFilePath = ".\\Дополнительные материалы\\Файловая система\\Информация о файле\\file.docx";
		//Чтобы узнать информацию о файле, необходимо указать "Путь", путь должен быть абсолютным иначе активность выдаст ошибку
		//Активность возращает переменную LTools.Data.Model.FileInfo в которой хранится информация о файле
		//*Активность работает с файлами любого формата
		
        LTools.Data.Model.FileInfo fileInfo = LTools.Data.Model.FileInfo.ReadInfo(System.IO.Path.GetFullPath(strFilePath));
		
		LTools.Workflow.PrimoApp.AddToLog(wf, "Значение параметра " + fileInfo.Properties[1].Header + ": " + fileInfo.Properties[1].Value ,LTools.Enums.LogMessageType.Info);
    }
}</Value>
            </SerializationItem>
