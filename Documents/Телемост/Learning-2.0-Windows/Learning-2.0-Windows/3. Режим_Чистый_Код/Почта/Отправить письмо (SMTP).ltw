                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, осуществляющий отправку почтового сообщения по протоколу SMTP.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		from - От: [String] Адресат - От кого
		to - Кому: [String] Адресат - Кому
		subject - Тема: [String] Тема сообщения
		body - Содержимое: [String] Содержимое сообщения
		server - Сервер: [String] Адрес почтового сервера
		port - Порт: [Int32] Порт почтового сервера
		login - Логин: [String] Логин почтового сервера
		password - Пароль: [String] Пароль почтового сервера
		isHtml - HTML: [Boolean] Признак HTML-содержимого сообщения
		isSsl - SSL: [Boolean] Признак использования сервером соединения SSL
		attachments - Вложения: [System.Collections.Generic.List&lt;String&gt;] Пути к файлам вложений письма
		to - Таймаут: [Int32] Предельное время ожидания завершения процесса (мс)
		LTools.Network.MailApp.SMTPSend(wf, from, to, subject, body, server, port, login, password, isHtml, isSsl, [attachments], to);
   		*/
		
		//Внесите в данные переменные собственные данные для учетной записи
		string strUserName = "";
		string strUserPass = "";
		string strServer = "smtp.yandex.ru";
		string strBody = "&lt;p&gt;Добрый день!&lt;br&gt;Проводим обучение по работе с отправкой письма по SMTP.&lt;br&gt;Хорошего дня!&lt;/p&gt;";
		
		LTools.Network.MailApp.SMTPSend(wf, strUserName, "primo@yandex.ru", "Primo Learning", strBody, strServer, 587, strUserName, strUserPass, true, true, new List&lt;string&gt;(){@".\Дополнительные материалы\PDF\Входные данные\PrimoInfo.pdf"}, 60000);
	}
}</Value>
