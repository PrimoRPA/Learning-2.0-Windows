                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, активирующий указанную вкладку браузера. Он работает корректно либо внутри контейнеров «Открыть браузер» и «Присоединиться к браузеру», либо через переменную, ссылающуюся на браузер.
		app - [LTools.WebBrowser.BrowserInst] Переменная для сохранения ссылки на подключенный браузер
		Returns tab ID
		string tabId = app.ActivateTab(url, title);
		string tabId = app.ActivateTabById(tabId);
		string tabId = app.ActivateTabByIndex(tabIndex);
		*/
		
		LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, LTools.WebBrowser.Model.BrowserTypes.Chrome, "https://www.google.com/"); // открыть браузер
		System.Threading.Thread.Sleep(5000); // Ожидание 5 секунд для загрузки страницы
		app.OpenTab("https://docs.primo-rpa.ru/"); // Открытие дополнительной вкладки
		System.Threading.Thread.Sleep(5000); // Ожидание 5 секунд для загрузки страницы

		app.ActivateTab("https://www.google.com/", "*Google*"); // Активировать вкладку по url и заголовку страницы
		
		//app.Close(); //Компонент, завершающий работу браузера.
	}
}</Value>
