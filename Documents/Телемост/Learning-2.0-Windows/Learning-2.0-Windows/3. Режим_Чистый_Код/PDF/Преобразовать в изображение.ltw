                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
     /* 
		Компонент, преобразующий документ PDF в изображения.  Свойства
	- wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
	- fileName - Путь к файлу: [String] Путь к файлу PDF, который нужно преобразовать в изображение
	- len - Размер: [int] Длина наибольшей стороны изображения (пиксели)
	- password - Пароль: [String] Пароль документа PDF. Указывется в том случае, если PDF документ защищён паролем
		
		List&lt;System.Drawing.Bitmap&gt; img = LTools.Office.PdfApp.ConvertToImage(wf, fileName, len, [password])
	*/	
		
	List&lt;System.Drawing.Bitmap&gt; img = LTools.Office.PdfApp.ConvertToImage(wf, @".\Дополнительные материалы\PDF\Входные данные\PrimoInfo.pdf", 10000);
    }
}</Value>
