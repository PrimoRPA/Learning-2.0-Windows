                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, производящий удаление учетных данных из Credential Manager.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		target - Ключ: [String] Ключ, для поиска записанных данных
		LTools.Cryptography.CryptoApp.CredentialsDelete(wf, target);
		*/
		
		// Запись учетных данных в Credential Manager для дальнейшер работы. 
		// В случае, если у вас есть сохраненные учетные данные, можно настроить следующую активность на работу с ними
		
		var strTarget = "MyKey"; //Ключ для дальнейшего доступа
		var strLogin = "primoLearning"; // Имя пользователя
		var strPassword = "NewCred"; // Пароль пользователя
		
		LTools.Cryptography.CryptoApp.CredentialsSet(wf, strTarget, true, strLogin, strPassword);
		
		LTools.Cryptography.CryptoApp.CredentialsDelete(wf, strTarget); // Удаление учетных данных
    }
}</Value>
