                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Элемент, обрабатывающий цвет текста документа.  Свойства
		app - [LTools.Office.WordApp] Приложение Word
		selStart - Начало: [Int32] Начало текста
		selLength - Длина: [Int32] Длина текста
		color - Цвет: [System.Drawinf.Color] Текущий цвет
		System.Drawing.Color color = app.GetTextColor([selStart], [selLength]);
		app.SetTextColor(selStart, selLength, color)
		*/
		
		//Инициализация документа MS Word
		LTools.Office.WordApp app = LTools.Office.WordApp.Init(wf, @".\Дополнительные материалы\Приложение Word\Входные данные\Информация об RPA.docx", LTools.Office.Model.InteropTypes.DX);
   
		//Изменение шрифта в документе MsWord
		app.SetTextColor(0, 52, System.Drawing.Color.Red);
		
		//Сохранение изменений документа MS Word
		app.SaveAs(@".\Дополнительные материалы\Приложение Word\Выходные данные\Цвет шрифта.docx");
    }
}</Value>
