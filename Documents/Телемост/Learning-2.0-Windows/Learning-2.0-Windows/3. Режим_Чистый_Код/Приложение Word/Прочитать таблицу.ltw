                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Элемент, читающий таблицу из документа. Элемент работает корректно только внутри контейнера Word  Свойства
		app - [LTools.Office.WordApp] Приложение Word
		idx - Индекс*: [Int32] Порядковый номер таблицы
		List&lt;List&lt;string&gt;&gt; list = app.ReadTableArr(idx);
		System.Data.DataTable table = app.ReadTable(idx);
		*/
		
		//Инициализация документа MS Word
		LTools.Office.WordApp app = LTools.Office.WordApp.Init(wf, @".\Дополнительные материалы\Приложение Word\Входные данные\Таблица персонал.docx", LTools.Office.Model.InteropTypes.DX);
   
		//Чтение таблицы из файла MsWord
		System.Data.DataTable dtTableWithInfo = app.ReadTable(0);
		
		LTools.Workflow.PrimoApp.AddToLog(wf, "Количество полученных строк таблицы: " + dtTableWithInfo.Rows.Count.ToString(), LTools.Enums.LogMessageType.Info);
	}
}</Value>
