                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
       /* 
		Компонент, добавляющий водяной знак к документу PDF.  Свойства
	- wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
	- fileName - Путь к файлу: [String] Путь к файлу PDF, в который необходимо добавить водяной знак
	- dest - Путь к результату: [String] Путь к результирующему файлу PDF, представляющиму собой исходный текст и водяой знак
	- text - Текст: [String] Текст водяного знака, который будет добавлен в документ
	- password - Пароль: [String] Пароль документа PDF. Указывется в том случае, если PDF документ защищён паролем
	- pages - Страницы: [String] Номера страниц документа, на которые необходимо добавить водяной знак. В случае, если параметр не указан водяно знак будет добавлен на все страницы документа
	- font - Имя шрифта: [String] Имя шрифта водяного знака. Для работы можно выбрать любой из шрифтов, встроенных в вашу систему. Примеры таких шрифтов:  "Arial Black, "Times New Roman", "Georgia".
	- fontSize - Размер шрифта: [int] Размер шрифта водяного знака, который будет добавлен в документ. Важно учест, что водяной знак добавляется только в центр выбранных страниц документа.
		
	   LTools.Office.PdfApp.AddWatermark(wf, fileName, dest, text, [password], [pages], [font], [fontSize]);
		*/
		
	LTools.Office.PdfApp.AddWatermark(wf, @".\Дополнительные материалы\PDF\Входные данные\PrimoInfo.pdf", @".\Дополнительные материалы\PDF\Выходные данные\PrimoWatermark.pdf", "Primo RPA", "", "1", "Arial Black", 12);   
    }
}
</Value>
