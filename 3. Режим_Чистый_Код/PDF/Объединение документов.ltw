                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
    /* 
		Компонент, объединяющий два документа PDF в один. Свойства:
		- wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		- fileName1 - Путь к файлу 1: [String] Путь к первому файлу PDF, который нужно объединить. Страницы данного файла в результирующем документа будет располагаться в начале
		- fileName2 - Путь к файлу 2: [String] Путь ко второму файлу PDF, который нужно объединить
		- dest - Путь к результату: [String] Путь к результирующему файлу PDF, в котором соединены два документа 
		
		LTools.Office.PdfApp.Merge(wf, fileName1, fileName2, dest);
	*/
		
	LTools.Office.PdfApp.Merge(wf, 
		/*Путь до файла 1*/@".\Дополнительные материалы\PDF\Входные данные\PrimoInfo.pdf", 
		/*Путь до файла 2*/@".\Дополнительные материалы\PDF\Входные данные\PrimoInfoNew.pdf", 
		/*Путь до итогового файла*/@".\Дополнительные материалы\PDF\Выходные данные\PrimoInfoAll.pdf");
    }
}</Value>
