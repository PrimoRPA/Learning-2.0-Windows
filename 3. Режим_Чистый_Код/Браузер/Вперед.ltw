                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
       /*
		Компонент, осуществляющий навигацию вперед.
		app - [LTools.WebBrowser.BrowserInst] Переменная для сохранения ссылки на подключенный браузер
		app.NavigateForward(); 
		*/
		
		LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, LTools.WebBrowser.Model.BrowserTypes.Chrome, "https://docs.primo-rpa.ru/primo-rpa"); // Открыть браузер
		System.Threading.Thread.Sleep(5000); // Ожидание 5 секунд для загрузки страницы
		app.Click("{\"Tag\":\"A\",\"Text\":\"Полезные ресурсы\",\"SearchFrames\":false,\"Attributes\":[]}",10000,LTools.Desktop.Model.MouseButtons.BUTTON_LEFT);// Переход на новую страницу, путем нажатия на кнопку
		System.Threading.Thread.Sleep(5000); // Ожидание 5 секунд для загрузки страницы
		
		app.NavigateBack();
		System.Threading.Thread.Sleep(000); // Ожидание 10 секунд для загрузки страницы
		
		app.NavigateForward(); 
		
		app.Close(); //Компонент, завершающий работу браузера.
		
    }
}</Value>
