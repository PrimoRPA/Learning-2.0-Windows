                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, производящий открытие нового экземпляра браузера.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		type - Тип браузера: [LTools.WebBrowser.Model.BrowserTypes] Тип используемого браузера
		invis - Скрывать: Запускать невидимым (только для WebDriver, кроме Edge)
		url - URL: [String] URL страницы 
		LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, type, url, [invis]);
		*/
		
		//app - переменнаядля сохранения ссылки на подключенный браузер. Для работы со страницами браузера необходимо будет указывать данное подключение
		var strUrl = "https://www.google.com/"; // портал, который необходимо открыть
		LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, LTools.WebBrowser.Model.BrowserTypes.Chrome, strUrl);
		
		//app.Close(); //Компонент, завершающий работу браузера.
    }
}</Value>
