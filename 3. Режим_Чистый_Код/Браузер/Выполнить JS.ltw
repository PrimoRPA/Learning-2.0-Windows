                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
      /*
		Компонент, выполняющий скрипт JS в браузере.  Свойства
		app - [LTools.WebBrowser.BrowserInst] Переменная для сохранения ссылки на подключенный браузер
		text - Скрипт: [String] Выполняемый скрипт
		args - Аргумент: [String] Аргумент функции
		pattern - Шаблон поиска: Шаблон поиска элемента
		element - Элемент: [LTools.WebBrowser.Model.IElementInfo] Ссылка на элемент управления
		timeOut - Таймаут: [Int32] Предельное время ожидания завершения процесса (мс)
		string ret = app.Eval(text, [timeOut]);
		string ret = app.Eval(text, args, element, [timeOut]);
		string ret = app.Eval(text, args, pattern, [timeOut]);
		*/ 
		
		LTools.WebBrowser.BrowserApp app = LTools.WebBrowser.BrowserApp.Open(wf, LTools.WebBrowser.Model.BrowserTypes.Chrome, "https://www.google.com/"); // открыть браузер
		System.Threading.Thread.Sleep(5000); // Ожидание 5 секунд для загрузки страницы
		
		string strScriptResult = app.Eval("document.getElementById('APjFqb').value = 'Primo Studio Test Components'" , 10000);
		
		//app.Close(); //Компонент, завершающий работу браузера.
	}
}</Value>
