                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, сохраняющий на диск сообщение электронной почты  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		msg - Сообщение*: [LTools.Network.Model.EMail.MailMessage] Сообщение для сохранения
		file - Путь*: [String] Путь сохранения файла
		LTools.Network.MailApp.SaveMessage(wf, msg, file);
		*/
		
		//Внесите в данные переменные собственные данные для учетной записи
		string strUserName = "";
		string strUserPass = "";
		string strServer = "imap.yandex.ru";
		
		List&lt;LTools.Network.Model.EMail.MailMessage&gt; listMail = LTools.Network.MailApp.IMAPReceive(wf, strServer, 993, strUserName, strUserPass, "Inbox", true, false, false, new List&lt;LTools.Network.Model.EMail.MailMessage&gt;(), null, null, true, true, 60000);
    	
		string strPathSave = System.IO.Path.GetFullPath(@".\\Дополнительные материалы\Почта\My message.eml");
		LTools.Network.MailApp.SaveMessage(wf, listMail[0], strPathSave);
    }
}</Value>
