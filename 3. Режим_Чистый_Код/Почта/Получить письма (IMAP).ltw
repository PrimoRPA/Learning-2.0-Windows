                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, осуществляющий получение почтовых сообщений по протоколу IMAP.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		server - Сервер: [String] Адрес почтового сервера
		port - Порт: [Int32] Порт почтового сервера
		login - Логин: [String] Логин почтового сервера
		password - Пароль: [String] Пароль почтового сервера
		inbox - Папка: [String] Папка входящих сообщений
		readUnread - Только непрочитанные: [Boolean] Получать только непрочитанные сообщения
		markRead - Метить, как прочитанные: [Boolean] Автоматически метить полученные сообщения, как прочитанные
		markUnread - Метить, как непрочитанные: [Boolean] Автоматически метить полученные сообщения, как непрочитанные
		ids - Идентификаторы: [System.Collections.Generic.List&lt;String&gt;] Массив идентификаторов получаемых сообщений
		messages - Письма: [System.Collections.Generic.List&lt;LTools.Network.Model.EMail.MailMessage&gt;] Массив сообщений
		dateFrom - Дата от: [DateTime?] Дата начала фильтра сообщений
		dateTo - Дата до: [DateTime?] Дата окончания фильтра сообщений
		readAtts - Получать вложения: [Boolean] Признак получения вложений
		isSsl - SSL: [Boolean] Признак использования сервером соединения SSL
		to - Таймаут: [Int32] Предельное время ожидания завершения процесса (мс)
		List&lt;LTools.Network.Model.EMail.MailMessage&gt; mail = LTools.Network.MailApp.IMAPReceive(wf, server, port, login, password, inbox, readUnread, markRead, markUnread, ids, dateFrom, dateTo, readAtts, isSsl, to, useSSO, sso));
		List&lt;LTools.Network.Model.EMail.MailMessage&gt; mail = LTools.Network.MailApp.IMAPReceive(wf, server, port, login, password, inbox, readUnread, markRead, markUnread, messages, dateFrom, dateTo, readAtts, isSsl, to, useSSO, sso));
   */
		
		//Внесите в данные переменные собственные данные для учетной записи
		string userName = "";
		string userPass = "";
		string ImapServer = "imap.yandex.ru";
		
		List&lt;LTools.Network.Model.EMail.MailMessage&gt; mail = LTools.Network.MailApp.IMAPReceive(wf, ImapServer, 993, userName, userPass, "Inbox", true, false, false, new List&lt;LTools.Network.Model.EMail.MailMessage&gt;(), null, null, true, true, 60000);
  
	}
}</Value>
