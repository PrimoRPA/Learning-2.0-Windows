public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, проговаривающий голосом заданное сообщение.  Свойства
		wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		text - Текст: [String] Произносимое сообщение
		textSsml - Текст SSML: [String] Сообщение в формате SSML
		voice - Голос: [String] Используемый голос
		volume - Громкость: [Int32] Громкость голоса
		rate - Скорость: [Int32] Скорость произношения
		LTools.Workflow.PrimoApp.Speech(wf, text, [voice], [volume], [rate]);
		LTools.Workflow.PrimoApp.SpeechSsml(wf, textSsml, [voice], [volume], [rate]);
		*/
    }
}</Value>
