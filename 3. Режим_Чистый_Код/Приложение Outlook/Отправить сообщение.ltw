                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, производящий отправку электронной почты через Outlook.  Свойства
		app - [LTools.Office.OutlookApp] Приложение Outlook
		message - Переменная: [LTools.Office.Model.OMailMessage] Данные отправляемого сообщения
		body - Тело письма: [String] Тело отправляемого сообщения
		sendTo - Кому: [String] Адресат сообщения
		subject - Тема: [String] Тема сообщения
		attachments - Вложения: [System.Collections.Generic.List&lt;String&gt;] Пути к файлам вложений письма
		format - [LTools.Office.Model.OMailMessage.MailFormats] Формат: Формат сообщения
		acc - Имя аккаунта: [String] Имя аккаунта, от которого будет отправлено сообщение
		app.SendMessage(message, acc);
		app.SendMessage(body, sendTo, subject, acc, [attachments], [format]);
		*/
		
		LTools.Office.OutlookApp app = LTools.Office.OutlookApp.Init(wf, "Outlook");
		
		string body = "Добрый день! Отправляю Вам письмо в рамках ознакомления работы активности \"Отправить сообщение\"";
		app.SendMessage(body, "test@primo-rpa.ru", "Обучение PrimoRPA", "testPrimo@primo-rpa.ru");
    }
}</Value>
