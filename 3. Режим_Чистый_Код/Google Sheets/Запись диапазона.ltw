                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, записывающий данные диапазона ячеек в Google Sheets.  Свойства
        app - [LTools.Office.GoogleSheetsApp] Приложение Google Sheets
        data - Переменная (текст): [List&lt;List&lt;object&gt;&gt;] Переменная для хранения данных записи значений
        range - Диапазон: [String] Диапазон записи ячеек (A1:D12)
        sheet - Страница: [String] Наименование страницы
        app.WriteRange(data, range, sheet);
		*/
		
		var googleDocID = ""; //ID документа Google Sheets. Для работы внесите свое значение id
		
		//Настройки активность "Документ Google Sheets" следует произвести в соотвествии с шагами, описанными в "Документ Google Sheets.ltw" данного проекта:	
		LTools.Office.GoogleSheetsApp app = LTools.Office.GoogleSheetsApp.Init(wf, @".\Дополнительные материалы\Google Sheets\client_secret.json", googleDocID);
		
		var data = new List&lt;List&lt;object&gt;&gt; {new List&lt;object&gt;{"Primo RPA", "Learning"}}; //Данные, которые необходимо внести в таблицу. Переменная должна быть в формате List&lt;List&lt;object&gt;&gt;
		var range = "A1";//Ячейки, в которые необходимо произвести запись данных. Необходимо указывать в формате строки "A1:D12". Диапазон расширяется автоматически до размера введенных данных
		var sheet = "NewData"; //Название страницы, на которую будут внесены данные
		
		app.WriteRange(data, range, sheet);
    }
}</Value>
            </SerializationItem>
