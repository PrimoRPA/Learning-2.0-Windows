                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*Компонент, считывающий данные из диапазона ячеек Google Sheets.  Свойства
        app - [LTools.Office.GoogleSheetsApp] Приложение Google Sheets
        range - Диапазон: [String] Диапазон считывания ячеек (A1:D12). Если не указан, будет прочитан выделенный диапазон
        sheet - Страница: [String] Наименование страницы
        List&lt;List&lt;string&gt;&gt; data = app.ReadRange(range, sheet); - получение результатов чтения текстовых значений в формате текста в списке List&lt;List&lt;string&gt;&gt;
        List&lt;List&lt;LTools.Office.Model.ExcelCellInfo&gt;&gt; data = app.ReadRangeInfo(range, sheet); - информация о считываемых ячейках
        System.Data.DataTable data = app.ReadRangeTable(range, sheet); - получение результатов чтения текстовых значений в формате таблицы
		*/
		
		var googleDocID = ""; //ID документа Google Sheets. Для работы внесите свое значение id
		
		//Настройки активность "Документ Google Sheets" следует произвести в соотвествии с шагами, описанными в "Документ Google Sheets.ltw" данного проекта:	
		LTools.Office.GoogleSheetsApp app = LTools.Office.GoogleSheetsApp.Init(wf, @".\Дополнительные материалы\Google Sheets\client_secret.json", googleDocID);
		
		var range = "A1:C4";//Ячейки, которые необходимо прочитать. Необходимо указывать в формате строки "A1:D12". В случае, если диапазон не указан, будет считан диапазон, выделенны пользователем в таблице
		var sheet = "NewData"; //Название страницы, с которой будут считываться данные
		
		//Выберите необходимую переменную для вывода информации и расскомментируйте ее
		
		//List&lt;List&lt;string&gt;&gt; data = app.ReadRange(range, sheet);
        //List&lt;List&lt;LTools.Office.Model.ExcelCellInfo&gt;&gt; data = app.ReadRangeInfo(range, sheet);
        System.Data.DataTable data = app.ReadRangeTable(range, sheet);
    }
}

