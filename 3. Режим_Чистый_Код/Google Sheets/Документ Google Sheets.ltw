                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*Компонент, производящий подключение к документу Google Sheets.  Свойства
        wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
        fileName - Путь к файлу: [String] Путь к файлу авторизации
        sheetId - ID документа: [String] ID документа Google Sheets
        LTools.Office.GoogleSheetsApp app = LTools.Office.GoogleSheetsApp.Init(wf, fileName, sheetId);
		
		Для работы с активностями Google Sheets необходимо создать свое приложение для работы с API. 
		Шаги, которые необходимо выполнить перед началом работы, описаны в докумнтации по ссылке: https://docs.primo-rpa.ru/primo-rpa/g_elements/el_basic/gsheets
		
		Также необходимо указать ссылку на портал для получения токенов, чтобы была возможность перенаправления пользователя для авторизации, 
		например https://developers.google.com/oauthplayground/. Необходимо ввести данные клиента и выбирать области, к которым необходимо предоставить доступ.
		*/
		
		var strGoogleDocID = ""; //ID документа Google Sheets. Для работы внесите свое значение id
			
		LTools.Office.GoogleSheetsApp app = LTools.Office.GoogleSheetsApp.Init(wf, @".\Дополнительные материалы\Google Sheets\client_secret.json", strGoogleDocID);
    }
}</Value>
