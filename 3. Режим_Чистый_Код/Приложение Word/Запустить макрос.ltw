                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		/*
		Элемент, выполняющий макрос Word.  Свойства:
		app - [LTools.Office.WordApp] Приложение Word
		name - Наименование: [String] Наименование макроса
		args - Аргументы: [List&lt;object&gt;] Аргументы макроса
		visible - Видимость: Видимость Word
		app.RunMacro(name, [args], [visible]);
		*/
		
        LTools.Office.WordApp app = LTools.Office.WordApp.Init(wf, System.IO.Path.GetFullPath(@".\Дополнительные материалы\Приложение Word\Входные данные\Информация об RPA.docm"), LTools.Office.Model.InteropTypes.Interop);
		
		var name = "ChangeColorVBA";
		app.RunMacro(name);
		
		//Сохранение изменений документа MS Word
		app.SaveAs(System.IO.Path.GetFullPath(@".\Дополнительные материалы\Приложение Word\Выходные данные\Запустить макрос.docm"));
    }
}</Value>
