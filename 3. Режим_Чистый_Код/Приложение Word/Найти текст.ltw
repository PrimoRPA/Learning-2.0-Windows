                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Ищет вхождение заданного текста в документ.  Свойства
		app - [LTools.Office.WordApp] Приложение Word
		text - Текст: [String] Искомый текст
		List&lt;int&gt; idxs = app.FindText(text);
		int? idx = app.FindTextFirst(text);
		*/
		
		//Инициализация документа MS Word
		LTools.Office.WordApp app = LTools.Office.WordApp.Init(wf, @".\Дополнительные материалы\Приложение Word\Входные данные\Информация об RPA.docx", LTools.Office.Model.InteropTypes.DX);
   
		List&lt;int&gt; idxs = app.FindText("бизнес-процессов");
		
    }
}</Value>
