                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		var strTxtPath = ".\\Дополнительные материалы\\Файловая система\\Добавить в файл\\file.txt";
		var strText = "Привет";
		var bByte = new System.Byte[]{0, 16, 104, 213};
		
		//Чтобы сделать запись в файл, необходимо указать "Путь к файлу", путь может быть абсолютный или относительный
		//В данном случае в файл txt вносится строка strText и bByte
		//*Активность работает только с файлами формата .png и .txt, файлы другого формата будут ломаться после добавления строки
        System.IO.File.WriteAllText(strTxtPath, strText);
		System.IO.File.WriteAllBytes(strTxtPath, bByte);
    }
}</Value>
