                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		var strFilePath = ".\\Дополнительные материалы\\Файловая система\\Удалить файл\\Отчет за " + DateTime.Now.ToString("dd.MM.yyyy") + ".docx";
		//Чтобы удалить файл используйте if (true)
		//Чтобы создать файл используйте if (false)
		if (false){
			//Чтобы удалить файл или папку, необходимо указать свойство "Путь", путь может быть абсолютный или относительный
			//*Активность работает с файлами любого формата
	 		System.IO.File.Delete(strFilePath);
	 	}else{
			//*Создать файл для удаления
	   		System.IO.File.Create(strFilePath);
		}
    }
}</Value>
