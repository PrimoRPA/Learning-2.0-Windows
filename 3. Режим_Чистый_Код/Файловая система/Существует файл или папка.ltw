                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		var strFilePath = ".\\Дополнительные материалы\\Файловая система\\Существует файл или папка\\file.txt";
		var strFolderPath = ".\\Дополнительные материалы\\Файловая система\\Существует файл или папка\\directory";
		bool boolExist = false;
		
		//Чтобы проверить существование файла используйте if (true)
		//Чтобы проверить существование папки используйте if (false)
		if (true){
			//Чтобы проверить существование файла, необходимо указать свойство "Путь", путь может быть абсолютный или относительный. Для проверки именно файла необходимо отключить свойство "Искать папку" (изначально отключено)
			//Активность возращает переменную "boolExist" (тип System.Boolean) true или false в зависимости от того, существует файл или нет
			//*Активность работает с файлами любого формата
	 		boolExist = System.IO.File.Exists(strFilePath);
	 	}else{
			//Чтобы проверить существование папки, необходимо указать свойство "Путь", путь может быть абсолютный или относительный. Для проверки именно папки необходимо включить свойство "Искать папку"
			//Активность возращает переменную "boolExist" (тип System.Boolean) true или false в зависимости от того, существует папка или нет
	   		boolExist = System.IO.Directory.Exists(strFolderPath);
		}
		
		LTools.Workflow.PrimoApp.AddToLog(wf, boolExist ? "Объект существует на диске" : "Объект не существует на диске", LTools.Enums.LogMessageType.Info);
    }
}</Value>
