                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		//Компонент, создающий новый архив файлов.  Свойства
		//wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		//path - Путь: [String] Путь к файлам архива (c:\folder\)
		//file - Архив: [String] Путь к создаваемому архиву (c:\folder\file.zip)
		//format - [LTools.Data.Model.ArchiveFormats] Формат: Формат архива
		//password - Пароль: [String] Пароль архива
		//szPath - Путь к 7-zip: [String] Путь к 7zip.dll (C:\Program Files\7-Zip\7z.dll)
		
		LTools.Data.ArchiveApp.Compress(wf, 
									/*Папка которую необходимо архивировать*/@".\Дополнительные материалы\Архив\Входные данные\Архивировать\", 
									/*Путь до конечного результата*/@".\Дополнительные материалы\Архив\Выходные данные\Архивировать\OutArc.zip", 
									/*Формат архива*/LTools.Data.Model.ArchiveFormats.Zip, 
									/*Пароль к архиву (если необходим)*/"", 
									/*путь до библиотеки  Путь к 7zip.dll*/@"C:\Program Files\7-Zip\7z.dll");
    }
}</Value>
