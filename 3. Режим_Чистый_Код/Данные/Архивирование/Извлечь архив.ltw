                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
      	/*
		Компонент, распаковывающий архив файлов.  Свойства
		- wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
		- path - Путь: [String] Cтроковое значение, которое указывает путь к папке, в которую будут извлечены файлы.
		- file - Архив: [String] Cтроковое значение, которое указывает путь к архиву, который нужно распаковать.
		- password - Пароль: [String] Пароль архива. Указывется в том случае, если архив защищён паролем
		- szPath - Путь к 7-zip: [String] Строковое значение, которое указывает путь к 7-zip.dll. (C:\Program Files\7-Zip\7z.dll)
		*/
		
		LTools.Data.ArchiveApp.Extract(wf, /*На выход должен появиться файл по пути:*/@".\Дополнительные материалы\Архив\Выходные данные\", 
										/*На вход дается архив, расположенный по пути:*/@".\Дополнительные материалы\Архив\Входные данные\123.zip", "", 
										/*Путь до библиотеки 7z.dll*/@"C:\Program Files\7-Zip\7z.dll");  
		
		
    }
}</Value>
