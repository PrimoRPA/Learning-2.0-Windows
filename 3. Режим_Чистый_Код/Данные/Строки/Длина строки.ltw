                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		//Указание пути до исходного файла
        string strPathFileINN = @".\Дополнительные материалы\Данные\ИНН.xlsx";
		//Присоединение к исходному файлу
		LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, strPathFileINN, ";", LTools.Office.Model.InteropTypes.DX);
		//Чтение таблицы из исходного файла
		List&lt;List&lt;string&gt;&gt; data = app.ReadRange("*", "ИНН");
		//Обрабатка считанной таблицы построчно
		foreach (var val in data)
		{
			//Вычисление с помощью компонента "Длина строки" количество символов строки из столбца "ИНН"
			int ret = val[1].ToString().Length; 
			//Определение равняется ли количество символов в строке из столбца "ИНН" числу 12
			if (ret == 12)
			{
				//Если количество символов в строке равняется числу 12 - то происходит вывод в информационном окне данных из столбца "Имя".
				LTools.Workflow.PrimoApp.MessageBox(wf, val[1].ToString());
			}
		}//Цикл будет повторяться пока не обработается последняя строка в считанной таблице
    }
}</Value>
