                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		string html = String.Format("&lt;table&gt;&lt;tr&gt;&lt;th&gt;текст заголовка1&lt;/th&gt;&lt;th&gt;текст заголовка2&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;данные1&lt;/td&gt;&lt;td&gt;данные2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;");
     /*
		Преобразовывает HTML-код в коллекцию таблиц. Элемент полезно применять в случаях, когда требуется извлечь таблицы из HTML-кода, например, из тела письма. 
		При этом код может содержать одну и более таблиц
		Для работы с активность необходимо заполнить следующие обязательные свойства:
		
		- html - HTML: [String] Докмуент HTML
		*/		
		List&lt;System.Data.DataTable&gt; tables = LTools.Data.Helpers.HTMLHelper.ParseTable(html);   
		
		//Компонент-цикл, перебирающий все значения выбранного массива.
		foreach (System.Data.DataTable table in tables)
		{
    		//Компонент, производящий запись сообщения в пользовательский журнал.  Свойства
			//wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
			//msg - Текст: [String] Текст сообщения
			//messageType - Тип: Тип сообщения
			LTools.Workflow.PrimoApp.AddToLog(wf, string.Join(Environment.NewLine, table.Rows.Cast&lt;DataRow&gt;().Select(row =&gt; string.Join("\t", row.ItemArray))), LTools.Enums.LogMessageType.Info);
		}
    }
}</Value>
            </SerializationItem>
