                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
       	var strPath = "C:";
		var arrPaths = System.IO.Directory.GetFiles(strPath);
		//Для работы цикла необходимо указать переменную коллекции (arrPaths), 
		//так же требуется указать переменную для одного экземпляра (path). 
		//Так же для работы активности необходимо указать тип данных (string)

		//*Данный цикл работает с любым типом коллекций
		foreach (string path in arrPaths)
		{
			LTools.Workflow.PrimoApp.AddToLog(wf, path, LTools.Enums.LogMessageType.Info);
		} 
    }
}</Value>
