                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		//В случае, если в блоке Try произойдет ошибка (предусмотренная или не предусмотренная) 
		//робот перейтет в блок Catch для выполнения сценария обработки ошибки. Блок Finally будет 
		//выполнен в любом случае, даже если в блоке Catch снова возникла ошибка (как правило, не 
		//пердусмотренная)

		//В случаях, когда необходимо выйти из ltw после получения ошибки в блоке Try используется:
		//1) Оборачивание всего сценария в Try-Catch
		//2) Активность повтор исключения (процесс пойдет искать Try-Catch оборачивающий ltw в котором вызвана ошибка)
		//3) Активность исключение (процесс пойдет искать Try-Catch оборачивающий ltw в котором вызвана ошибка)
		//4) Активность выход из процесса 
		//*Любой из вариантов, в любом случае, выполнит действия в блоке Finally
		try
		{
			LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Try", LTools.Enums.LogMessageType.Info);
			throw new Exception("Исключение для демонстрации Try-Catch");
		}
		catch (Exception e) when (e is not OperationCanceledException)
		{
			LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Catch", LTools.Enums.LogMessageType.Info);
		}
		finally
		{
			LTools.Workflow.PrimoApp.AddToLog(wf, "Блок Finally", LTools.Enums.LogMessageType.Info);
		}
		LTools.Workflow.PrimoApp.AddToLog(wf, "Снаруже контейнера Try Catch", LTools.Enums.LogMessageType.Info);
    }
}</Value>
            </SerializationItem>
