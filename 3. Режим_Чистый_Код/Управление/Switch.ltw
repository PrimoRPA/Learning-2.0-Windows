                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		var boolSwitch = 2 &lt; 3;
		//Данный контейнер позволяет выбрать сценарий в зависимости от выражения, 
		//которое передается в свойство "Условие"
		
		//Активность принимает в себя значения типов:
		//1) bool
		//2) string
		//3) int
		
		//*В случае если не один из вариантов не подходит, данный контейнер 
		//имеет блок "По умолчанию" в котором можно прописать свой сценарий 
		//на случай, если не подойдет ни один из вариантов
		switch (boolSwitch)
		{
			case true:
				LTools.Workflow.PrimoApp.AddToLog(wf, "true", LTools.Enums.LogMessageType.Info);
            break;
			
			case false:
				LTools.Workflow.PrimoApp.AddToLog(wf, "false", LTools.Enums.LogMessageType.Info);
            break;
			
			default:
				LTools.Workflow.PrimoApp.AddToLog(wf, "Не подошло ни одно из условий", LTools.Enums.LogMessageType.Info);
            break;
		}
    }
}</Value>
