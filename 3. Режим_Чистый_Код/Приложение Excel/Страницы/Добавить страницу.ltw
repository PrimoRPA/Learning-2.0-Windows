                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, создающий новую страницу в Excel.  Свойства
		app - [LTools.Office.ExcelApp] Приложение Excel
		sheet - Имя: [String] Название страницы, которая будет добавлена в документ Excel, указанный в контейнере Приложение Excel
		sheetIdx - Индекс: [Int32] порядковый номер новой страницы. Нумерация начинается с нуля. В случае, если значение не указано новый лист будет добавлен после имеющихся листов в книге Excel
		app.SheetAdd(sheet, [sheetIdx]);
		*/
		
		//Для работы данного элемента необходимо в начале инициализировать приложение Excel
		var fileName = @".\Дополнительные материалы\Приложение Excel\Входные данные\PrimoLearning.xlsx";
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, fileName, ";", LTools.Office.Model.InteropTypes.DX);
		
		app.SheetAdd("Новая страница", 1);
		
		//Для отображения результата необходимо сохранить внесенные изменения
		app.SaveAs(@".\Дополнительные материалы\Приложение Excel\Выходные данные\PrimoLearningAddSheet.xlsx");
    }
}</Value>
            </SerializationItem>
