                <Name>ScriptCode</Name>
                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
        /*
		Компонент, производящий подключение к приложению Excel. В случае отсутствия указанного файла, будет создан новый.  Свойства
        wf: [LTools.Common.Model.WorkflowData] ссылка на вызывающий алгоритм
        fileName - Путь к файлу: [String] Путь к файлу документа Excel (c:\folder\file.xlsx)
        bytes - Массив байтов: [byte[]] Массив байтов документа
        csvDel - Разделитель: [String] Разделитель колонок. Для режима Interop необходима кодировка UTF-8 BOM или UTF-16 LE
        interop - [LTools.Office.Model.InteropTypes] Драйвер: Тип драйвера подключения:
		• Interop - необходим установленный на машине MS Office. Позволяет выполнять VBA и макросы. Скорость работы с файлом ниже
        • DX - нет необходимости в MS Office. Нельзя выполнять VBA и макросы. Скорость работы с файлом выше
        loadAddIns - Загружать AddIn-ы: Загружать установленные дополнения
        isAttach - Присоединяться: Присоединяться к открытому документу (только для Interop)
        pass - Пароль: [String] Пароль документа
		
		LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, fileName, [csvDel], [interop], [loadAddIns], [isAttach], [pass]);
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, bytes, [csvDel], [interop], [loadAddIns], [pass]);
		 */
		var fileName = @".\Дополнительные материалы\Приложение Excel\Входные данные\PrimoLearning.xlsx";
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, fileName, ";", LTools.Office.Model.InteropTypes.DX);
    }
}</Value>
            </SerializationItem>
