                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		/*
		Компонент, сохраняющий файл Excel в формате PDF
		app - [LTools.Office.ExcelApp] Приложение Excel
		path - Путь: [String] Путь к файлу PDF, который будет создан в результате работы активности
		replaceExisting - Заменять существующий: [Boolean] Заменять существующий файл PDF
		start - Индекс первой страницы: [Int32] Индекс первой страницы
		end - Индекс последней страницы: [Int32] Индекс последней страницы
		minQuality - Мин. качество: [Boolean] Минимальное качество выходного файла.
		app.ExportToPdf(path, replaceExisting, minQuality, [start], [end]);
		*/
		
        //Для работы данного элемента необходимо в начале инициализировать приложение Excel
		var fileName = @".\Дополнительные материалы\Приложение Excel\Входные данные\PrimoLearning.xlsx";
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, fileName, ";", LTools.Office.Model.InteropTypes.DX);
		
		app.ExportToPdf(@".\Дополнительные материалы\Приложение Excel\Выходные данные\PrimoLearning.pdf", true, false, 0, 2);

    }
}</Value>
