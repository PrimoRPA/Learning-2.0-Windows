                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		/*
		Компонент, производящий запись данных в ячейку Excel.  Свойства
		app - [LTools.Office.ExcelApp] Приложение Excel
		cell - Ячейка: [String] Ячейки для заполнения. Указывается в формате A1 или в формате R1C1 в зависимости от настроек контейнера Excel
		text - Данные: [String] Информация, которая должна быть добавлена в документ Excel
		sheet - Страница: [String] Наименование страницы
		sheetIdx - Индекс страницы: [Int32] Индекс страницы
		numFormat - Числовой формат: [String] Формат вводимого числа (#,#)
		Для того, чтобы текст в документу был задан в виде строки, необходимо удалить свойство numFormat.
		В случае если не указан sheetIdx  или sheet данные будут добавлены на первый лист книги.
		app.WriteCell(cell, text, [sheet], [sheetIdx], [numFormat]);
		*/
		
        //Для работы данного элемента необходимо в начале инициализировать приложение Excel
		var fileName = @".\Дополнительные материалы\Приложение Excel\Входные данные\PrimoLearning.xlsx";
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, fileName, ";", LTools.Office.Model.InteropTypes.DX);
		
		app.WriteCell("F2", "10950,23", "Персонал", null, "#,#"); // - как число
		//app.WriteCell("F2", "10950,23", "Персонал"); // - как текст
		
		//Для отображения результата необходимо сохранить внесенные изменения
		app.SaveAs(@".\Дополнительные материалы\Приложение Excel\Выходные данные\PrimoLearningCellInput.xlsx");
    }
}</Value>
            </SerializationItem>
