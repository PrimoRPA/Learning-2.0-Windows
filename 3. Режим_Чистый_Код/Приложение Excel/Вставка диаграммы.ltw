                <Value xsi:type="xsd:string">using System;
using System.Collections.Generic;
using System.Text;
using LTools.Scripting.Model;
using LTools.Network.Model;

public class PrimoScript
{
	public static LTools.Scripting.CSharp.ScriptDebugger __debug;
	
	public void main(LTools.Common.Model.WorkflowData wf)
    {
		/*
		Компонент, создающий диаграмму на листе Excel.  Свойства
		app - [LTools.Office.ExcelApp] Приложение Excel
		range - Диапазон: [String] Диапазон данных (A1:D12). Если не указан, будет использован выделенный диапазон.  Если указан символ "*", будет использован весь лист
		sheet - Страница: [String] Наименование страницы
		sheetIdx - Индекс страницы: [Int32] Индекс страницы
		cht - Тип: Тип диаграммы. Area - диаграмма с областями. Существуют и другие типы: Bar -линейная, Column - столбчатая, Pie - круговая и д.р. 
		Подробнее о типах диаграмм можно узнать в документации по ссылке: https://docs.primo-rpa.ru/primo-rpa/g_elements/el_basic/els_excel/el_excel_createchart
		cLeft - Слева: [Int32] Отступ слева
		cTop - Сверху: [Int32] Отступ сверху
		cWidth - Ширина: [Int32] Ширина диаграммы
		cHeight - Высота: [Int32] Высота диаграммы
		LTools.Office.Model.Excel.ExcelChartItem data = app.InsertChart(range, cht, [sheet], [sheetIdx], [cLeft], [cTop], [cWidth], [cHeight]);
		
		В случае если не указаны свойства активности диаграмма будет создана на первом листе книги Excel, указанной в контейнере, в ячейке A1. Данные для диаграммы будут выбрано автоматически
		*/
		
        //Для работы данного элемента необходимо в начале инициализировать приложение Excel
		var strFileName = @".\Дополнительные материалы\Приложение Excel\Входные данные\PrimoLearning.xlsx";
        LTools.Office.ExcelApp app = LTools.Office.ExcelApp.Init(wf, strFileName, ";", LTools.Office.Model.InteropTypes.DX);
		
		LTools.Office.Model.Excel.ExcelChartItem chartLink = app.InsertChart("B2:E12", LTools.Office.Model.Excel.ChartTypes.Area, "Копия персонала", null, 2000, 100, 1500, 1000);
		
		//Для отображения результата необходимо сохранить внесенные изменения
		app.SaveAs(@".\Дополнительные материалы\Приложение Excel\Выходные данные\PrimoLearningInsertСhart.xlsx");
    }
}</Value>
            </SerializationItem>
